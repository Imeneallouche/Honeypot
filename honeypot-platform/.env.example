# ━━━━━━━━━ Honeypot Ports ━━━━━━━━━
SSH_HONEYPOT_PORT=2222
HTTP_HONEYPOT_PORT=8080

# ━━━━━━━━━ API ━━━━━━━━━
API_PORT=8000
API_SECRET_KEY=change-me-in-production-min-32-chars-use-long-random-string
API_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ━━━━━━━━━ Admin dashboard login (JWT source) ━━━━━━━━━
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# ━━━━━━━━━ Database ━━━━━━━━━
# Inside Docker Compose, path is mounted at /app/data
DATABASE_URL=sqlite+aiosqlite:///./data/honeypot.db

# ━━━━━━━━━ Paths (relative to project root inside containers: /app) ━━━━━━━━━
LOG_DIR=./logs
REPORTS_DIR=./reports

# ━━━━━━━━━ GeoIP (MaxMind GeoLite2 City) ━━━━━━━━━
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# ━━━━━━━━━ Analytics / pipeline ━━━━━━━━━
ANALYTICS_INTERVAL_MINUTES=5
INGEST_POLL_INTERVAL_SECONDS=2

# ━━━━━━━━━ Alerting ━━━━━━━━━
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=honeypot@yourdomain.com
ALERT_EMAIL_TO=security@yourdomain.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_TLS=true

ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=

ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# Minimum severity to send via channel: LOW | MEDIUM | HIGH | CRITICAL
ALERT_MIN_SEVERITY_EMAIL=HIGH
ALERT_MIN_SEVERITY_SLACK=MEDIUM
ALERT_MIN_SEVERITY_WEBHOOK=LOW

# ━━━━━━━━━ AbuseIPDB (optional reputation) ━━━━━━━━━
ABUSEIPDB_API_KEY=

# ━━━━━━━━━ CORS (comma-separated origins) ━━━━━━━━━
CORS_ORIGINS=http://localhost:3000

# ━━━━━━━━━ Elasticsearch export (optional) ━━━━━━━━━
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=honeypot-events
